{
    "routes": [
        {
            "pattern": "/@(?<username>[a-zA-Z0-9_]+)",
            "target": "pages/users/page.php",
            "query_params": {
                "username": "$username"
            }
        },
        {
            "pattern": "/profile/(?<userid>[0-9]+)",
            "target": "pages/users/page.php",
            "query_params": {
                "userid": "$userid"
            }
        },
         {
            "pattern": "/livre/(?<id>\\d+)",
            "target": "pages/books/page.php",
            "query_params": {
                "id": "$id"
            }
        },
        {
            "pattern": "/admin/study-areas/new",
            "target": "pages/admin/books/study-area/new.php"
        },
        {
            "pattern": "/admin/study-areas/edit/(?<prefill>[0-9,]+)",
            "target": "pages/admin/books/study-area/new.php",
            "query_params": {
                "prefill": "$prefill"
            }
        }
    ]
}